{
  "version": 1,
  "hooks": {
    "PreToolUse": [
      {
        "type": "command",
        "matcher": "Read|Edit|Write",
        "bash": "python3 \"__COPILOT_HOME__/hooks/check_sensitive_files.py\"",
        "timeoutSec": 5
      },
      {
        "type": "command",
        "matcher": "Bash",
        "bash": "python3 \"__COPILOT_HOME__/hooks/command_policy.py\"",
        "timeoutSec": 5
      },
      {
        "type": "command",
        "matcher": "Bash",
        "bash": "python3 \"__COPILOT_HOME__/hooks/worktree_guard.py\"",
        "timeoutSec": 5
      },
      {
        "type": "command",
        "matcher": "Bash|Grep|Glob",
        "bash": "python3 \"__COPILOT_HOME__/hooks/graphify_hint.py\"",
        "timeoutSec": 5
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "matcher": "Edit|Write",
        "bash": "python3 \"__COPILOT_HOME__/hooks/graphify_update_notice.py\"",
        "timeoutSec": 5
      }
    ]
  }
}
